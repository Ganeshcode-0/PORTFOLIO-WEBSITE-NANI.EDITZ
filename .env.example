# Supabase Public Configuration (Required for Supabase production mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Supabase Service Role Key (Server-side administrative authorization only - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Cloudinary or Video Provider Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
